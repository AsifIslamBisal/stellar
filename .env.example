# Stellar / RAMS API credentials for the LOCAL TEST APP ONLY.
#
# ############################################################################
# #  WARNING                                                                 #
# #                                                                          #
# #  Anything prefixed with VITE_ is injected into the client bundle and is  #
# #  therefore READABLE BY ANYONE WHO OPENS DEVTOOLS on this page. Vite does  #
# #  not keep VITE_* values secret - there is no server-side step here.      #
# #                                                                          #
# #  This is acceptable ONLY because this app is local and throwaway.        #
# #  A real deployment (e.g. Pathshala) MUST keep auth_code on a server and   #
# #  must never ship it to the browser.                                      #
# ############################################################################
#
# Copy this file to .env and fill in the values, e.g.:
#   cp .env.example .env      (macOS / Linux / Git Bash)
#   Copy-Item .env.example .env   (PowerShell)
#
# .env is gitignored so credentials do not get committed.

VITE_STELLAR_AUTH_USER=
VITE_STELLAR_AUTH_CODE=
